# CX Trust Control Plane — local development environment template
# Copy to .env (never commit .env). All secrets stay out of git.

APP_ENV=development
DEMO_MODE=true
# Governance execution mode: enforce (default) | shadow (detect+log, never block)
# GOVERNANCE_MODE=shadow

# Governance API
CXTRUST_PORT=8787
CXTRUST_DB=./results/demo.db
# Auth: comma-separated API keys. UNSET = auth disabled (local dev only!)
# CXTRUST_API_KEYS=dev-key-1
# RBAC (optional): CXTRUST_ADMIN_TOKENS=... / CXTRUST_ORG_TOKENS=org-id:token

# Connectors (ports + HMAC secrets, >=16 chars; or configure via UI)
# CXTRUST_CONNECT_PORT=8799
# CXTRUST_TWILIO_PORT=8800
# CXTRUST_NICE_SECRET=
# CXTRUST_CISCO_SECRET=
# CXTRUST_AVAYA_SECRET=
# CXTRUST_FIVE9_SECRET=

# STT
CXTRUST_STT=demo
# CXTRUST_DEEPGRAM_KEY=

# Optional subsystems (default off)
# CXTRUST_ALERTING=on
# CXTRUST_TRUSTNET=on
# CXTRUST_DB_URL=postgres://...

# Feature flags (defaults in code; override here)
# ENABLE_RAG_GOVERNANCE=false
# ENABLE_DEEPFAKE_DETECTION=false
# ENABLE_TEST_LAB=true
# ENABLE_LIVE_ASR_ROUTER=false

# asr-worker sidecar (Phase 8)
# ASR_SIDECAR_URL=http://127.0.0.1:8810

# --- docker compose (docker-compose.yml interpolates these from .env) ---
# Everything commented out = local defaults that work with auth DISABLED
# (fine for local dev; never run production this way).
# Comma-separated API keys clients must send as X-API-Key:
# CXTRUST_API_KEYS=dev-key-1
# Key the web console sends (must match one entry above IF keys are enabled):
# CXTRUST_API_KEY=dev-key-1
# enforce (default) | shadow — detect and log, never block:
# GOVERNANCE_MODE=shadow
# Basic-auth for /console when running behind Traefik (htpasswd -nbB user pass):
# CONSOLE_BASICAUTH=admin:$2y$05$...